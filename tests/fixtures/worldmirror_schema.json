{
  "VNCCS_SavePLY": {
    "input": {
      "required": {
        "ply_data": [
          "PLY_DATA"
        ],
        "filename": [
          "STRING",
          {
            "default": "output"
          }
        ]
      }
    }
  },
  "VNCCS_LoadWorldMirrorV2Model": {
    "input": {
      "optional": {
        "device": [
          [
            "cuda",
            "cpu"
          ],
          {
            "default": "cuda"
          }
        ],
        "precision": [
          [
            "bf16",
            "fp8",
            "float32"
          ],
          {
            "default": "bf16",
            "tooltip": "bf16: recommended, ~2\u00d7 VRAM vs float32. fp8: weight-only quantization via torchao, ~2\u00d7 vs bf16 (requires torchao, Ampere+). float32: full precision."
          }
        ]
      }
    }
  },
  "VNCCS_BackgroundPreview": {
    "input": {
      "required": {},
      "optional": {
        "ply_path": [
          "STRING",
          {
            "forceInput": true,
            "tooltip": "Path to a Gaussian Splatting PLY file"
          }
        ],
        "camera_poses": [
          "TENSOR",
          {
            "tooltip": "Optional: camera poses tensor from WorldMirror V2. Used to initialize the viewer camera."
          }
        ],
        "camera_intrinsics": [
          "TENSOR",
          {
            "tooltip": "Optional: camera intrinsics tensor from WorldMirror V2. Used for viewer FOV."
          }
        ],
        "coordinate_basis": [
          [
            "auto",
            "worldmirror",
            "hyworld2_worldgen"
          ],
          {
            "default": "auto",
            "tooltip": "Coordinate basis of the PLY/camera tensors. Use hyworld2_worldgen for official HYWorld2 trainer outputs."
          }
        ]
      }
    }
  },
