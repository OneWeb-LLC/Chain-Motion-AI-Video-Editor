{
  "name": "frameforge",
  "private": true,
  "version": "1.0.0",
  "description": "Frameforge — scene-based AI video studio (OWeb satellite)",
  "scripts": {
    "dev": "npm run sync:static && next dev",
    "build": "npm run sync:static && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "smoke:satellite": "node scripts/smoke-satellite.mjs",
    "audit:production": "node scripts/audit-production-satellite.mjs",
    "e2e:satellite-api": "bash scripts/e2e-satellite-api.sh",
    "sync:static": "mkdir -p public && rm -rf public/static && cp -r static public/static"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.106.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0"
  }
}
