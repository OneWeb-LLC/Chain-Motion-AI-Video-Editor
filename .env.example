NEXT_PUBLIC_SUPABASE_URL=https://auth.oweb.one
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OWeb control plane (SSO redeem: POST /api/v1/ecosystem/redeem-launch-token)
NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
NEXT_PUBLIC_OWEB_PLATFORM_API_URL=https://oweb.one/api/v1

# This satellite public URL (SSO return target — set in Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Enforce OneID on /studio (default: true in production)
NEXT_PUBLIC_FF_REQUIRE_AUTH=true

# Optional: Python Frameforge API (ComfyUI orchestration + library). When unset, the
# browser editor loads after login but API calls fail until a backend is configured.
# FRAMEFORGE_API_URL=https://your-frameforge-api.example.com
# FRAMEFORGE_PROXY_SECRET=generate-a-long-random-shared-secret
